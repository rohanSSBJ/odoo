generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FLEET_MANAGER
  DRIVER
  SAFETY_OFFICER
  FINANCIAL_ANALYST
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_SHOP
  RETIRED
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  SUSPENDED
}

enum TripStatus {
  DRAFT
  DISPATCHED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")

  trips Trip[]

  @@index([email])
  @@map("users")
}

model Vehicle {
  id              String        @id @default(uuid())
  regNo           String        @unique @map("reg_no")
  name            String
  type            String
  maxLoadKg       Float         @map("max_load_kg")
  odometer        Float         @default(0)
  acquisitionCost Float         @default(0) @map("acquisition_cost")
  status          VehicleStatus @default(AVAILABLE)
  createdAt       DateTime      @default(now()) @map("created_at")

  trips           Trip[]
  maintenanceLogs MaintenanceLog[]
  fuelLogs        FuelLog[]
  expenses        Expense[]

  @@index([status])
  @@map("vehicles")
}

model Driver {
  id              String       @id @default(uuid())
  name            String
  licenseNo       String       @unique @map("license_no")
  licenseCategory String       @map("license_category")
  licenseExpiry   DateTime     @map("license_expiry")
  contact         String?
  safetyScore     Float        @default(100) @map("safety_score")
  status          DriverStatus @default(AVAILABLE)
  createdAt       DateTime     @default(now()) @map("created_at")

  trips Trip[]

  @@index([status])
  @@index([licenseExpiry])
  @@map("drivers")
}

model Trip {
  id              String     @id @default(uuid())
  source          String
  destination     String
  vehicleId       String     @map("vehicle_id")
  driverId        String     @map("driver_id")
  createdById     String?    @map("created_by_id")
  cargoWeight     Float      @map("cargo_weight")
  plannedDistance Float      @map("planned_distance")
  finalOdometer   Float?     @map("final_odometer")
  fuelConsumed    Float?     @map("fuel_consumed")
  revenue         Float?
  status          TripStatus @default(DRAFT)
  createdAt       DateTime   @default(now()) @map("created_at")

  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Restrict)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  fuelLogs  FuelLog[]

  @@index([status])
  @@index([vehicleId])
  @@index([driverId])
  @@map("trips")
}

model MaintenanceLog {
  id        String    @id @default(uuid())
  vehicleId String    @map("vehicle_id")
  type      String
  cost      Float     @default(0)
  notes     String?
  isOpen    Boolean   @default(true) @map("is_open")
  openedAt  DateTime  @default(now()) @map("opened_at")
  closedAt  DateTime? @map("closed_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([isOpen])
  @@map("maintenance_logs")
}

model FuelLog {
  id        String   @id @default(uuid())
  vehicleId String   @map("vehicle_id")
  tripId    String?  @map("trip_id")
  liters    Float
  cost      Float
  date      DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trip    Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@map("fuel_logs")
}

model Expense {
  id        String   @id @default(uuid())
  vehicleId String   @map("vehicle_id")
  category  String
  amount    Float
  date      DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("expenses")
}
